data/*
# The measured CSV and rendered charts are the point of running a profile and
# are small; the raw per-run datasets under data/runs/ are not -- long,
# machine-specific, and already summarised into data/results/.
!data/results/
!data/results/**
# Extracted schemas are committed -- they are inputs to E3 phase 2 and must be
# reproducible alongside it -- but the raw docker output that produced them is
# not, being long, machine-specific and already summarised in extraction.json.
schemas/extracted/**/*.extraction.log
__pycache__/
*.egg-info/
.pytest_cache/
.codegraph/
.venv/

# generators/lemming/vendor/ IS committed, deliberately. The shaded jar is
# 96.3 MiB -- inside GitHub's 100 MiB blob limit, though over the 50 MiB
# warning threshold. It is committed because the upstream Maven host it would
# otherwise be built from is offline, so this jar is currently the only way to
# build the image at all; see generators/lemming/BUILD_ISSUE.txt. Deliberate
# repository weight, in exchange for the benchmark staying reproducible.
